# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Keep False in production. Only set True for local debugging.
DJANGO_DEBUG=False

# Comma-separated. e.g. myapp.onrender.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origin(s) allowed to call this API.
# e.g. https://mybookingapp.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Neon Postgres connection string — get this from your Neon dashboard
# (Connection Details -> copy the "psql" or "connection string" value).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# If left blank, falls back to a local SQLite file automatically.
DATABASE_URL=

# From resend.com dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
